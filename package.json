{
  "name": "discord-chat-extractor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that exports Discord chat history (servers, channels, DMs) to TXT / Markdown / HTML / Excel / CSV / JSON.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "e2e": "node e2e/real-extension.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
