{
  "name": "discord-chat-extractor",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "author": "LanturnHouse",
  "type": "module",
  "description": "Chrome extension that exports Discord chat history (servers, channels, DMs) to TXT / Markdown / HTML / Excel / CSV / JSON.",
  "homepage": "https://github.com/LanturnHouse/discord-chat-extractor#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LanturnHouse/discord-chat-extractor.git"
  },
  "bugs": {
    "url": "https://github.com/LanturnHouse/discord-chat-extractor/issues"
  },
  "keywords": [
    "discord",
    "chrome-extension",
    "manifest-v3",
    "export",
    "backup",
    "archive",
    "chat-history",
    "html",
    "markdown",
    "csv",
    "xlsx",
    "json"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "e2e": "node e2e/real-extension.mjs",
    "licenses": "node scripts/third-party-licenses.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
